# Copie para .env e preencha. O .env fica fora do git (.gitignore).
#   cp .env.example .env

# TypeSafe AI (Jev) — usado por `pnpm smoke:jev` e pelo JevDecider.
# Pegue em https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Provedor de LLM do agente (OpenRouter por padrao).
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=anthropic/claude-sonnet-4-20250514

# Embeddings — opcional; sem isso usa o mesmo provedor do LLM.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
