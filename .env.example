# Copie para .env e preencha. O .env fica fora do git (.gitignore).
#   cp .env.example .env

# TypeSafe AI (Jev) — usado por `pnpm smoke:jev` e pelo JevDecider.
# Pegue em https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Provedor de LLM do agente. O default do SDK e o OpenRouter, entao a chave
# precisa combinar com o baseUrl: chave `sk-or-...` com openrouter.ai, chave
# `sk-proj-...` (OpenAI) exige descomentar LLM_BASE_URL abaixo. Trocar so a
# chave, sem trocar o endpoint, da 401 "Missing Authentication header".
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=anthropic/claude-sonnet-5

# Usando a OpenAI direta:
# LLM_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-6-astra

# Embeddings — opcional; sem isso usa o mesmo provedor do LLM.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small