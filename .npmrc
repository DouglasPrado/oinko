strict-peer-dependencies=false

# O escopo @gba resolve no registry privado.
#
# A CREDENCIAL NAO MORA AQUI: o pnpm 11 IGNORA `_authToken` com variavel de
# ambiente quando a linha vem de um .npmrc de projeto, porque o arquivo e
# versionado. O caminho que ele aceita e o npmrc do USUARIO (`npm adduser`).
@gba:registry=https://npm.dify.com.br/
