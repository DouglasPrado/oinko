# Telegram — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# LLM API — the key must match the endpoint. The SDK defaults to OpenRouter,
# so an `sk-proj-...` (OpenAI) key needs LLM_BASE_URL uncommented as well —
# swapping only the key gives 401 "Missing Authentication header".
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=anthropic/claude-sonnet-5

# Using OpenAI directly instead:
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-5.6
#
# A linha gpt-6 nao aceita tools em /chat/completions, que e o unico endpoint
# que o SDK fala — com as tools do bot ligadas, `gpt-6-astra` falha no primeiro
# turno. A gpt-5.6 aceita, mas so com reasoning_effort 'none', que o cliente
# manda sozinho: nesse endpoint sao tools OU reasoning, nunca os dois. Para as
# duas coisas, gpt-5.5 ou um gateway que fale /v1/responses.

# Embedding provider (optional — defaults to LLM provider above)
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Tavily (optional) — get from https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# Admin Telegram user ID (optional, for /admin commands)
# ADMIN_USER_ID=123456789

# MCP Albert (optional) — remote MCP server via SSE
# MCP_ALBERT_URL=https://mcp.oialbert.com.br/mcp
# MCP_ALBERT_TOKEN=your-token-here

# TypeSafe AI (Jev) — decisor tipado. Sem isto o bot roda nas heuristicas.
# Pegue em https://console.typesafe.ai/
# TYPESAFE_API_KEY=api-xxxxxxxxxxxxxxxxxxxx

# Onde gravar o log de decisoes (para `pnpm analyze:decisions`)
# DECISION_LOG=./data/decisions.jsonl

# Modelo barato para turnos triviais. So vale com TYPESAFE_API_KEY.
# O nome do modelo segue a convencao do endpoint: com prefixo de provedor
# no OpenRouter (anthropic/claude-haiku-4.5), sem prefixo na OpenAI direta
# (gpt-5.4-mini). Trocar o baseUrl sem revisar os nomes da 400.
# FAST_MODEL=anthropic/claude-haiku-4.5
