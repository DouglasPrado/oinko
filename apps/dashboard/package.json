{
  "name": "@oinko/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w build:packages",
    "dev": "next dev -H 127.0.0.1 -p 3111",
    "prebuild": "pnpm -w build:packages",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3111",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start:network": "node scripts/network.mjs start",
    "dev:network": "node scripts/network.mjs dev"
  },
  "dependencies": {
    "@oinko/workspaces": "workspace:*",
    "@oinko/environments": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5",
    "@oinko/mcp-higgsfield": "workspace:*",
    "@oinko/bots": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.11",
    "@oinko/core": "workspace:*"
  }
