{
  "name": "@oinko/oink-lp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm -w build:packages",
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm build",
    "dev": "node --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "chat": "node --env-file-if-exists=.env dist/main.js chat",
    "status": "node --env-file-if-exists=.env dist/main.js status",
    "reload": "node --env-file-if-exists=.env dist/main.js reload"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@oinko/agent-runtime": "workspace:*",
    "@oinko/channel-cli": "workspace:*",
    "@oinko/channel-telegram": "workspace:*",
    "@oinko/mcp-higgsfield": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "eslint": "^10.3.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.59.2",
    "globals": "^15.15.0",
    "grammy": "^1.30.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
