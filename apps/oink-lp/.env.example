LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=

# Identidade e instruções únicas para todos os canais.
AGENT_ID=oink-lp
# AGENT_SYSTEM_PROMPT=Você é o Oink LP, um agente especializado em criar landing pages...
AGENT_DATA_DIR=./data
CLI_SESSION_ID=default
# CLI_CONNECTION_ID=local
# AGENT_CONNECTIONS_FILE=connections.json

# Necessários quando o canal Telegram está habilitado em connections.json.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Áudio: provedor compatível com /audio/transcriptions.
# Sem estas variáveis, usa a chave e a URL do LLM e o modelo padrão do SDK.
# Configure um provedor separado se o provedor de chat não oferecer transcrição.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1

# Dashboard: por padrão grava em AGENT_DATA_DIR/AGENT_ID/telemetry.db.
TELEMETRY=on
TELEMETRY_CAPTURE=full
TELEMETRY_RETENTION_DAYS=30
# TELEMETRY_DB_PATH=./data/oink-lp/telemetry.db

# Integração compartilhada (credencial da dashboard na raiz do monorepo).
HIGGSFIELD=on
HIGGSFIELD_TOOLS=generate_image,generate_video,job_status,jobs_wait,models_explore
# HIGGSFIELD_CREDENTIAL_PATH=/caminho/absoluto/higgsfield.json
