{
  "name": "@oinko/mcp-oinko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "oinko-mcp": "dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docker": "OINKO_DOCKER_TEST=1 vitest run tests/runtime.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oinko/bots": "workspace:*",
    "@oinko/environments": "workspace:*",
    "@oinko/workspaces": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
