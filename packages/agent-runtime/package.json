{
  "name": "@oinko/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "import": "./dist/control.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js"
    },
    "./programming": {
      "types": "./dist/programming/index.d.ts",
      "import": "./dist/programming/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@oinko/core": "workspace:*",
    "zod": "^4.4.3",
    "@oinko/workspaces": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^25.6.0",
    "vitest": "^4.1.11"
  }
}
