{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/dashboard": {
      "entry": [
        "src/app/**/{page,layout,route,error,global-error,not-found,loading}.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,tsx}"],
      "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["tests/e2e/**/*.spec.ts"]
      }
    }
  }
}
